#print axioms numerator_residual_exact
#print axioms den_tail_l1
#print axioms num_tail_l1
#print axioms denominator_residual
#print axioms numerator_residual
#print axioms parry_remainder_unconditional
#print axioms parry_remainder_x22
end Manuscript14.ParryUnconditional
