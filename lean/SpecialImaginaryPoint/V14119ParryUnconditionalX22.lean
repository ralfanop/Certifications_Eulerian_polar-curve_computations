theorem denominator_residual_exact (t : ℝ) :
    logTaylor 12 (E t) - t*A12 t = t^13 * eval denTail 132 t := by
  norm_num [logTaylor, E, A12, eval, a, denTail, Finset.sum_range_succ, Nat.factorial] <;> ring

theorem numerator_residual_exact (t : ℝ) :
    logTaylor 11 (U t) - C12 t = t^12 * eval numTail 110 t := by
  norm_num [logTaylor, U, C12, eval, c, numTail, Finset.sum_range_succ, Nat.factorial] <;> ring

theorem den_tail_l1 : (∑ i ∈ Finset.range 132, |(denTail i : ℝ)|) ≤ 1 := by
  norm_num [denTail, Finset.sum_range_succ]

theorem num_tail_l1 : (∑ i ∈ Finset.range 110, |(numTail i : ℝ)|) ≤ 1 := by
  norm_num [numTail, Finset.sum_range_succ]

theorem denominator_residual (t : ℝ) (ht : 0 < t) (ht1 : t ≤ 1) :
    |logTaylor 12 (E t)/t-A12 t| ≤ t^12 := by
  have hb : |eval denTail 132 t| ≤ 1 :=
    (eval_abs_bound denTail 132 t (by rw [abs_of_pos ht]; exact ht1)).trans den_tail_l1
  have he : logTaylor 12 (E t)/t-A12 t =
      (logTaylor 12 (E t)-t*A12 t)/t := by
    field_simp [ht.ne'] <;> ring
  rw [he, denominator_residual_exact, abs_div, abs_mul,
    abs_of_nonneg (pow_nonneg ht.le _), abs_of_pos ht]
  apply (div_le_iff₀ ht).2
  calc
    _ ≤ t^13 * 1 := mul_le_mul_of_nonneg_left hb (pow_nonneg ht.le _)
    _ = _ := by ring

theorem numerator_residual (t : ℝ) (ht : 0 ≤ t) (ht1 : t ≤ 1) :
    |logTaylor 11 (U t)-C12 t| ≤ t^12 := by
  have hb : |eval numTail 110 t| ≤ 1 :=
    (eval_abs_bound numTail 110 t (by rw [abs_of_nonneg ht]; exact ht1)).trans num_tail_l1
  rw [numerator_residual_exact, abs_mul, abs_of_nonneg (pow_nonneg ht _)]
  simpa only [mul_one] using mul_le_mul_of_nonneg_left hb (pow_nonneg ht 12)

/-- No finite residual hypotheses remain. -/
theorem parry_remainder_unconditional (x : ℝ) (hx : 0 < x) (hx1 : x ≤ 1/2) :
    |Real.log (1/(beta x-1))/Real.log (beta x) -
      (P12 (x^2)*Real.log (6/x^2)+R12 (x^2))/x^2| ≤
      3373*(x^2)^11*Real.log (6/x^2) := by
  have ht : 0 < x^2 := sq_pos_of_pos hx
  have ht1 : x^2 ≤ 1 := by nlinarith
  exact parry_from_finite_residuals x hx hx1
    (denominator_residual (x^2) ht ht1)
    (numerator_residual (x^2) ht.le ht1)

/-- Explicit order-22 log bound in the manuscript's original variable. -/
theorem parry_remainder_x22 (x : ℝ) (hx : 0 < x) (hx1 : x ≤ 1/6) :
    |Real.log (1/(beta x-1))/Real.log (beta x) -
      (P12 (x^2)*Real.log (6/x^2)+R12 (x^2))/x^2| ≤
      10119*x^22*Real.log (1/x) := by
  have h := parry_remainder_unconditional x hx (by linarith)
  have h6 : (6 : ℝ) ≤ 1/x := (le_div_iff₀ hx).2 (by linarith)
  have hl6 : Real.log 6 ≤ Real.log (1/x) := Real.log_le_log (by norm_num) h6
  have hl : Real.log (6/x^2) = Real.log 6 + 2*Real.log (1/x) := by
    rw [Real.log_div (by norm_num : (6:ℝ) ≠ 0) (pow_ne_zero _ hx.ne'),
      Real.log_pow, Real.log_div (by norm_num : (1:ℝ) ≠ 0) hx.ne', Real.log_one]
    ring
  have hll : Real.log (6/x^2) ≤ 3*Real.log (1/x) := by linarith
  calc
    _ ≤ 3373*(x^2)^11*Real.log (6/x^2) := h
    _ ≤ 3373*(x^2)^11*(3*Real.log (1/x)) :=
      mul_le_mul_of_nonneg_left hll (by positivity)
    _ = _ := by ring

