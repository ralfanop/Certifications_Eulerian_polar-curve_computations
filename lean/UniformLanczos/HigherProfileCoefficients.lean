noncomputable def IpPoly (x : ℝ) : ℝ := (12 : ℝ) * x + (144 / 5 : ℝ) * x ^ 3 + (19008 / 175 : ℝ) * x ^ 5 + (393984 / 875 : ℝ) * x ^ 7 + (129143808 / 67375 : ℝ) * x ^ 9 + (179132166144 / 21896875 : ℝ) * x ^ 11 + (3789966163968 / 109484375 : ℝ) * x ^ 13

