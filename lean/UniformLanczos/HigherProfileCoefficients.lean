noncomputable def GPolyD (α : ℝ) : ℝ := (1 / 3 : ℝ) + (-2 / 5 : ℝ) * α + (16 / 175 : ℝ) * α ^ 2 + (32 / 525 : ℝ) * α ^ 3 + (1472 / 67375 : ℝ) * α ^ 4 + (-4352 / 446875 : ℝ) * α ^ 5 + (-7544704 / 328453125 : ℝ) * α ^ 6

/-- `FPoly α = GPoly α / 4`: the printed coefficients of `F`. -/
noncomputable def FPoly (α : ℝ) : ℝ := (1 / 12 : ℝ) * α + (-1 / 20 : ℝ) * α ^ 2 + (4 / 525 : ℝ) * α ^ 3 + (2 / 525 : ℝ) * α ^ 4 + (368 / 336875 : ℝ) * α ^ 5 + (-544 / 1340625 : ℝ) * α ^ 6 + (-1886176 / 2299171875 : ℝ) * α ^ 7

