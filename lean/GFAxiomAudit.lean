open Lean

run_cmd do
  let env ← getEnv
  let mods := env.header.moduleNames
  let names : Array Name := env.constants.fold (init := #[]) fun acc n _ =>
    match env.getModuleIdxFor? n with
    | some i =>
        if (`GegenbauerFock).isPrefixOf (mods[i.toNat]!) && !n.isInternal then acc.push n else acc
    | none => acc
  let (_, st) := ((names.forM CollectAxioms.collect).run env).run {}
  logInfo m!"GegenbauerFock declarations audited: {names.size}"
  logInfo m!"axioms used (union): {st.axioms}"
  let std : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let bad := st.axioms.filter (fun a => !std.contains a)
  if bad.isEmpty then
    logInfo "RESULT: only propext, Classical.choice, Quot.sound"
  else
    let mut offenders : Array Name := #[]
    for n in names do
      let (_, s) := ((CollectAxioms.collect n).run env).run {}
      if s.axioms.any (fun a => bad.contains a) then offenders := offenders.push n
    logError m!"RESULT: nonstandard axioms {bad} used by {offenders}"
