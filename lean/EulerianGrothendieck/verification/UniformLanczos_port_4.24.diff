+    intro x hx
+    have hx1 : x ∈ Ioo (-b1) b1 := ⟨by linarith [hx.1], by linarith [hx.2]⟩
+    have hw := (hraw M hM0' x ⟨hx1.1.le, hx1.2.le⟩).1
+    have hlin : Continuous fun y : ℝ => (M:ℝ) * y := continuous_const.mul continuous_id
