import GegenbauerFock.GeneralUltrasphericalFock

/-!
# V007 — polynomial moment separation of the genuine ultraspherical Fock map

The kernel of the actual L²(ν_λ) → ℓ² Fock transform is exactly the
orthogonal complement of the *complex span of its monomial Riesz
representers*. Hence density of this explicitly defined polynomial
span implies injectivity. The result is not a circular injectivity
assumption: the exact kernel condition is proved from the nonvanishing
factorial/Gaussian weights and the certified coordinate formula.

An unconditional theorem establishing the density of that span in
the weighted L² probability space is a separate pending obligation.
-/

noncomputable section

namespace GegenbauerFock.GeneralUltrasphericalFock

open MeasureTheory

/-- The source polynomial subspace generated by the actual L² Riesz
monomials, with the precisely normalized ultraspherical probability
measure and the certified support condition. -/
noncomputable def sourceMonomial (lam : ℝ) (hlam : 0 < lam) (n : ℕ) :
    Lp ℂ 2 (Ultraspherical.measure lam) := by
  letI : IsProbabilityMeasure (Ultraspherical.measure lam) :=
    Ultraspherical.probability lam hlam
  exact WeightedMoments.monomial (Ultraspherical.measure lam)
    (ae_abs_le_one lam) n

noncomputable def sourceMonomialSpan (lam : ℝ) (hlam : 0 < lam) :
    Submodule ℂ (Lp ℂ 2 (Ultraspherical.measure lam)) :=
  Submodule.span ℂ (Set.range (sourceMonomial lam hlam))

/-- Every complex phase and Gaussian/factorial weight of the
Gegenbauer-Fock coefficient operator is nonzero for α>0. -/
theorem nonzero_fock_weight (alpha : ℝ) (ha : 0 < alpha) (n : ℕ) :
    WeightedMoments.complexWeight alpha n ≠ 0 := by
  have hp : 0 < WeightedMoments.squareWeight alpha n := by
    unfold WeightedMoments.squareWeight
    positivity
  intro hz
  have hn := WeightedMoments.complexWeight_norm_sq alpha ha n
  simp [hz] at hn
  exact (ne_of_gt hp) hn.symm

/-- A vector is annihilated by the *entire infinite coefficient map*
iff it is orthogonal to every actual Riesz monomial. This is the
full moment-separation statement, not a finite truncation. -/
theorem C_eq_zero_iff_monomial_moments_zero
    (lam alpha : ℝ) (hlam : 0 < lam) (ha : 0 < alpha)
    (f : Lp ℂ 2 (Ultraspherical.measure lam)) :
    C lam alpha hlam ha f = 0 ↔
      ∀ n : ℕ, inner ℂ (sourceMonomial lam hlam n) f = 0 := by
  letI : IsProbabilityMeasure (Ultraspherical.measure lam) :=
    Ultraspherical.probability lam hlam
  constructor
  · intro hf n
    have hcoord : C lam alpha hlam ha f n = 0 := by rw [hf]; rfl
    rw [C_coefficient] at hcoord
    have hprod :
        WeightedMoments.complexWeight alpha n *
          inner ℂ
            (WeightedMoments.monomial
              (Ultraspherical.measure lam) (ae_abs_le_one lam) n) f = 0 := by
      simpa [WeightedMoments.coefficient] using hcoord
    have hz := (mul_eq_zero.mp hprod).resolve_left
      (nonzero_fock_weight alpha ha n)
    simpa only [sourceMonomial] using hz
  · intro hf
    ext n
    rw [C_coefficient]
    change WeightedMoments.coefficient
      (Ultraspherical.measure lam) (ae_abs_le_one lam) alpha n f = 0
    have hmon : inner ℂ (WeightedMoments.monomial
        (Ultraspherical.measure lam) (ae_abs_le_one lam) n) f = 0 := by
      simpa only [sourceMonomial] using hf n
    simp [WeightedMoments.coefficient, hmon]

/-- The exact kernel is the orthogonal complement of the source
polynomial span. No density of polynomials is presumed. -/
theorem C_ker_eq_monomialSpan_orthogonal
    (lam alpha : ℝ) (hlam : 0 < lam) (ha : 0 < alpha) :
    (C lam alpha hlam ha).ker =
      (sourceMonomialSpan lam hlam)ᗮ := by
  letI : IsProbabilityMeasure (Ultraspherical.measure lam) :=
    Ultraspherical.probability lam hlam
  ext f
  change C lam alpha hlam ha f = 0 ↔ f ∈ (sourceMonomialSpan lam hlam)ᗮ
  constructor
  · intro hz
    have hn := (C_eq_zero_iff_monomial_moments_zero
      lam alpha hlam ha f).mp hz
    have hspan :
        sourceMonomialSpan lam hlam ≤ (innerSL ℂ f).ker := by
      unfold sourceMonomialSpan
      apply Submodule.span_le.mpr
      rintro v ⟨n, rfl⟩
      change inner ℂ f (sourceMonomial lam hlam n) = 0
      exact (inner_eq_zero_symm).mpr (hn n)
    apply (Submodule.mem_orthogonal' (sourceMonomialSpan lam hlam) f).2
    intro u hu
    exact hspan hu
  · intro hz
    apply (C_eq_zero_iff_monomial_moments_zero
      lam alpha hlam ha f).2
    intro n
    exact (Submodule.mem_orthogonal (sourceMonomialSpan lam hlam) f).1
      hz _ (Submodule.subset_span (Set.mem_range_self n))

/-- **Exact density reduction**. Once the genuinely weighted complex
monomials are known to be dense in the ultraspherical L² space, the
actual Gegenbauer-Fock map is injective. The density premise is
stated explicitly rather than smuggled in as an axiom. -/
theorem C_injective_of_monomialSpan_dense
    (lam alpha : ℝ) (hlam : 0 < lam) (ha : 0 < alpha)
    (hdense : (sourceMonomialSpan lam hlam).topologicalClosure = ⊤) :
    Function.Injective (C lam alpha hlam ha) := by
  have hker : (C lam alpha hlam ha).ker = ⊥ := by
    rw [C_ker_eq_monomialSpan_orthogonal,
      ← Submodule.orthogonal_closure, hdense]
    simp
  intro f g hfg
  have hsub : f - g ∈ (C lam alpha hlam ha).ker := by
    change C lam alpha hlam ha (f - g) = 0
    rw [map_sub, hfg, sub_self]
  rw [hker] at hsub
  have hzero : f - g = 0 := by simpa using hsub
  exact sub_eq_zero.mp hzero

/-- The missing polynomial-density lemma is not just sufficient but
*equivalent* to injectivity of the actual ultraspherical Fock operator.
The reverse direction uses the complete Hilbert-space double-orthogonal
theorem; no finite-dimensional or hypothetical density API is used. -/
theorem C_injective_iff_monomialSpan_dense
    (lam alpha : ℝ) (hlam : 0 < lam) (ha : 0 < alpha) :
    Function.Injective (C lam alpha hlam ha) ↔
      (sourceMonomialSpan lam hlam).topologicalClosure = ⊤ := by
  constructor
  · intro hinj
    have hker : (C lam alpha hlam ha).ker = ⊥ :=
      LinearMap.ker_eq_bot.mpr hinj
    rw [C_ker_eq_monomialSpan_orthogonal lam alpha hlam ha] at hker
    have hdouble := congrArg
      (fun K : Submodule ℂ (Lp ℂ 2 (Ultraspherical.measure lam)) => Kᗮ) hker
    simpa only [Submodule.orthogonal_orthogonal_eq_closure,
      Submodule.bot_orthogonal_eq_top] using hdouble
  · intro hdense
    exact C_injective_of_monomialSpan_dense
      lam alpha hlam ha hdense

#print axioms GegenbauerFock.GeneralUltrasphericalFock.nonzero_fock_weight
#print axioms GegenbauerFock.GeneralUltrasphericalFock.C_eq_zero_iff_monomial_moments_zero
#print axioms GegenbauerFock.GeneralUltrasphericalFock.C_ker_eq_monomialSpan_orthogonal
#print axioms GegenbauerFock.GeneralUltrasphericalFock.C_injective_of_monomialSpan_dense
#print axioms GegenbauerFock.GeneralUltrasphericalFock.C_injective_iff_monomialSpan_dense

end GegenbauerFock.GeneralUltrasphericalFock
