import GegenbauerFock.UltrasphericalSturmLiouvilleClosedEigenvectorSupport

/-!
# V007 — simplicity of every Gegenbauer Sturm point eigenvalue

Every eigenvector in the actual canonical closed Sturm domain corresponding
to degree n is a real scalar multiple of the explicitly normalized
degree-n Gegenbauer eigenfunction. This proves geometric multiplicity one,
without assuming simplicity from the abstract spectral theorem.

The coordinate argument uses the certified single-degree Fourier support
lemma, the exact Hilbert-basis representation, and `HilbertBasis.repr_self`.
-/

noncomputable section
namespace GegenbauerFock.Ultraspherical
open MeasureTheory

private abbrev SturmH (lam : ℝ) := Lp ℝ 2 (measure lam)

/-- Every genuine closed-domain eigenvector of eigenvalue
`-n(n+2λ)` belongs to the real line generated by the normalized
Gegenbauer degree-n mode; the eigenvalue is geometrically simple. -/
theorem sturmRealClosed_eigenvector_is_scalar_multiple_of_mode
    (lam : ℝ) (hlam : 0 < lam) (n : ℕ)
    (x : (sturmRealPartialOperator lam hlam).closure.domain)
    (hx : (sturmRealPartialOperator lam hlam).closure x =
      sturmEigenvalue lam n • (x : SturmH lam)) :
    ∃ c : ℝ, (x : SturmH lam) =
      c • sturmMonicEigenCandidate_realL2_normalized lam hlam n := by
  let b := sturmMonicEigenCandidate_realL2_hilbertBasis lam hlam
  refine ⟨(b.repr (x : SturmH lam)) n, ?_⟩
  have hb : b n =
      sturmMonicEigenCandidate_realL2_normalized lam hlam n := by
    simp only [b, sturmMonicEigenCandidate_realL2_hilbertBasis,
      HilbertBasis.coe_mkOfOrthogonalEqBot]
  rw [← hb]
  apply b.repr.injective
  ext m
  rw [map_smul, b.repr_self]
  by_cases hmn : m = n
  · subst m
    simp [lp.single_apply]
  · have hz :=
      sturmRealClosed_eigenvector_single_degree_support
        lam hlam n x hx m hmn
    change (b.repr (x : SturmH lam)) m = 0 at hz
    rw [hz]
    simp [lp.single_apply, hmn]

#print axioms GegenbauerFock.Ultraspherical.sturmRealClosed_eigenvector_is_scalar_multiple_of_mode

end GegenbauerFock.Ultraspherical
