/-! ### Low-order values of the formal operations -/

section
variable {K : Type*} [CommRing K]

theorem cmul_two' (a b : ℕ → K) : cmul a b 2 = a 0 * b 2 + a 1 * b 1 + a 2 * b 0 := by
  simp [cmul, sum_range_succ]

theorem cmul_three' (a b : ℕ → K) :
    cmul a b 3 = a 0 * b 3 + a 1 * b 2 + a 2 * b 1 + a 3 * b 0 := by
  simp [cmul, sum_range_succ]

theorem cmul_four' (a b : ℕ → K) :
    cmul a b 4 = a 0 * b 4 + a 1 * b 3 + a 2 * b 2 + a 3 * b 1 + a 4 * b 0 := by
  simp [cmul, sum_range_succ]

theorem ccomp_two' (a b : ℕ → K) : ccomp a b 2 = a 1 * b 1 + a 2 * b 0 ^ 2 := by
  simp [ccomp, cpow, cmul, sum_range_succ]
  ring

theorem ccomp_three' (a b : ℕ → K) :
    ccomp a b 3 = a 1 * b 2 + 2 * a 2 * b 0 * b 1 + a 3 * b 0 ^ 3 := by
  simp [ccomp, cpow, cmul, sum_range_succ]
  ring

theorem ccomp_four' (a b : ℕ → K) :
    ccomp a b 4 = a 1 * b 3 + a 2 * (2 * b 0 * b 2 + b 1 ^ 2) + 3 * a 3 * b 0 ^ 2 * b 1 +
      a 4 * b 0 ^ 4 := by
  simp [ccomp, cpow, cmul, sum_range_succ]
  ring

end

section
variable {K : Type*} [Field K]

theorem cinv_one1 (b : ℕ → K) (h : b 0 = 1) : cinv b 1 = -b 1 := by
  rw [cinv_one', h]; simp

theorem cinv_two1 (b : ℕ → K) (h : b 0 = 1) : cinv b 2 = b 1 ^ 2 - b 2 := by
  unfold cinv
  rw [ccomp_two', h]
  simp
  ring

theorem cinv_three1 (b : ℕ → K) (h : b 0 = 1) :
    cinv b 3 = -b 3 + 2 * b 1 * b 2 - b 1 ^ 3 := by
  unfold cinv
  rw [ccomp_three', h]
  simp
  ring

theorem cinv_four1 (b : ℕ → K) (h : b 0 = 1) :
    cinv b 4 = -b 4 + 2 * b 1 * b 3 + b 2 ^ 2 - 3 * b 1 ^ 2 * b 2 + b 1 ^ 4 := by
  unfold cinv
  rw [ccomp_four', h]
  simp
  ring

end

/-- Substitution of `z / (1 + z)`: the binomial pattern. -/
theorem ccomp_alt (X : ℕ → ℝ) :
    ccomp X (fun i => (-1 : ℝ) ^ i) 2 = X 2 - X 1 ∧
    ccomp X (fun i => (-1 : ℝ) ^ i) 3 = X 3 - 2 * X 2 + X 1 ∧
    ccomp X (fun i => (-1 : ℝ) ^ i) 4 = X 4 - 3 * X 3 + 3 * X 2 - X 1 := by
  refine ⟨?_, ?_, ?_⟩
  · rw [ccomp_two']; norm_num; ring
  · rw [ccomp_three']; norm_num; ring
  · rw [ccomp_four']; norm_num; ring

theorem binR_values :
    ((binQ 0 : ℚ) : ℝ) * 1 ^ 0 = 1 ∧ ((binQ 1 : ℚ) : ℝ) * 1 ^ 1 = -1 / 2 ∧
    ((binQ 2 : ℚ) : ℝ) * 1 ^ 2 = 3 / 8 ∧ ((binQ 3 : ℚ) : ℝ) * 1 ^ 3 = -5 / 16 ∧
    ((binQ 4 : ℚ) : ℝ) * 1 ^ 4 = 35 / 128 := by
  have h : binQ 0 = 1 ∧ binQ 1 = -1 / 2 ∧ binQ 2 = 3 / 8 ∧ binQ 3 = -5 / 16 ∧
      binQ 4 = 35 / 128 := by decide +kernel
  obtain ⟨h0, h1, h2, h3, h4⟩ := h
  rw [h0, h1, h2, h3, h4]
  norm_num

