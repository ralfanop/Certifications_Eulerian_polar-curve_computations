import PrivateApex.QuantCalculus
import PrivateApex.AngleAllOrders

/-!
PRIVATE.  Manuscript 15: explicit constants for the expansions of `sin u / u`, of its logarithm
and of the correction `kap` to the Gaussian exponent, on `0 ≤ u ≤ 1` and in the gauge `u ^ 2`.

`LogSincSeries` proves that these expansions exist.  Here every constant is explicit:

* `sinc_hasExpQ`: `|sinc u - ∑ k < P, sincC k u^(2k)| ≤ sK P u^(2P)`, with
  `sK P = (2P + 2) / ((2P + 1)! (2P + 1))`;
* `ysinc_hasExpQ`, `log_hasExpQ`, `Lsinc_hasExpQ`: the same for `(1 - sinc u) / u^2` and for
  `-log (sinc u)`, the latter with the constants `LK` computed by `compC`;
* `kap_hasExpQ`: the expansion of `kap` up to the order `8`, with the constants `kapK`;
* `kap_pow_bound`: the expansions of the powers `kap ^ k`, `k ≤ 7`, up to the order `7`, with the
  constants `kpK k q`;
* `kap_abs_le`: `|kap u| ≤ kapK 0`.

The file is generated by `work/gen_quant_sinc.py`.  The rational tables `LK10`, `kapK`, `kpK` are
upper bounds of the constants given by the formulas of `QuantCalculus`; each inequality is
checked by the kernel (`LK10_bound`, `kapK_bound`, `kpK_bound`).
-/

namespace PrivateApex
open Real Finset

/-! ### `sin u / u` -/

theorem sin_taylor_sharp (P : ℕ) {u : ℝ} (h0 : 0 ≤ u) (h1 : u ≤ 1) :
    |sin u - ∑ k ∈ range P, (-1) ^ k * u ^ (2 * k + 1) / ((2 * k + 1).factorial : ℝ)| ≤
      u ^ (2 * P + 1) *
        ((2 * (P : ℝ) + 2) / (((2 * P + 1).factorial : ℝ) * (2 * (P : ℝ) + 1))) := by
  have hn : ‖(u : ℂ) * Complex.I‖ = u := by simp [abs_of_nonneg h0]
  have hb := Complex.exp_bound (x := (u : ℂ) * Complex.I) (by rw [hn]; exact h1)
    (n := 2 * P + 1) (by omega)
  have him := Complex.abs_im_le_norm (Complex.exp ((u : ℂ) * Complex.I) -
    ∑ m ∈ range (2 * P + 1), ((u : ℂ) * Complex.I) ^ m / (m.factorial : ℂ))
  rw [Complex.sub_im, Complex.exp_ofReal_mul_I_im, sin_partial_im] at him
  refine him.trans (hb.trans (le_of_eq ?_))
  rw [hn]
  congr 1
  push_cast
  rw [div_eq_mul_inv]
  ring

/-- Constants of the expansion of `sin u / u`. -/
def sK (P : ℕ) : ℚ := (2 * P + 2) / ((2 * P + 1).factorial * (2 * P + 1))

theorem sinc_hasExpQ (n : ℕ) :
    HasExpQ (Set.Icc (0 : ℝ) 1) (fun u => u ^ 2) n sinc sincC sK := by
  intro P _ u hu
  obtain ⟨h0, h1⟩ := hu
  show |sinc u - ∑ i ∈ range P, (sincC i : ℝ) * (u ^ 2) ^ i| ≤ (sK P : ℝ) * |u ^ 2| ^ P
  have hsK : (sK P : ℝ) =
      (2 * (P : ℝ) + 2) / (((2 * P + 1).factorial : ℝ) * (2 * (P : ℝ) + 1)) := by
    simp [sK]
  have hsK0 : (0 : ℝ) ≤ (sK P : ℝ) := by rw [hsK]; positivity
  rcases eq_or_lt_of_le h0 with rfl | hpos
  · rcases P with _ | P
    · simp [sK]
    · have hs : ∑ i ∈ range (P + 1), (sincC i : ℝ) * ((0 : ℝ) ^ 2) ^ i = 1 := by
        rw [sum_range_succ']
        simp [sincC]
      rw [hs]
      simp
  · have ht := sin_taylor_sharp P h0 h1
    have e : sinc u - ∑ i ∈ range P, (sincC i : ℝ) * (u ^ 2) ^ i =
        (sin u - ∑ k ∈ range P, (-1) ^ k * u ^ (2 * k + 1) /
          ((2 * k + 1).factorial : ℝ)) / u := by
      rw [sinc_of_ne_zero hpos.ne', sub_div, sum_div]
      congr 1
      refine sum_congr rfl fun k _ => ?_
      simp only [sincC]
      push_cast
      field_simp
      ring
    rw [e, abs_div, abs_of_pos hpos, div_le_iff₀ hpos,
      abs_of_nonneg (by positivity : (0 : ℝ) ≤ u ^ 2), hsK]
    calc _ ≤ u ^ (2 * P + 1) *
          ((2 * (P : ℝ) + 2) / (((2 * P + 1).factorial : ℝ) * (2 * (P : ℝ) + 1))) := ht
      _ = _ := by ring

theorem gauge_sq_le_one : ∀ u ∈ Set.Icc (0 : ℝ) 1, |u ^ 2| ≤ ((1 : ℚ) : ℝ) := by
  intro u hu
  rw [abs_of_nonneg (by positivity)]
  have : u ^ 2 ≤ 1 := by nlinarith [hu.1, hu.2]
  simpa using this

/-! ### `(1 - sin u / u) / u ^ 2` -/

/-- Constants of the expansion of `ysinc`, before the improvement of the order zero. -/
def yK0 (P : ℕ) : ℚ := |sK (1 + P)| + if P = 0 then |sincC 1| else 0

theorem ysinc_hasExpQ0 (n : ℕ) :
    HasExpQ (Set.Icc (0 : ℝ) 1) (fun u => u ^ 2) n ysinc yC yK0 := by
  have e0 : sincC 0 = 1 := by decide +kernel
  have e1 : sincC 1 = -1 / 6 := by decide +kernel
  have h := (sinc_hasExpQ (1 + n)).shift 1 (g := fun u => -ysinc u)
    (fun u _ => by
      show sinc u = ∑ i ∈ range 1, (sincC i : ℝ) * (u ^ 2) ^ i + (u ^ 2) ^ 1 * -ysinc u
      rw [sum_range_one, e0]
      have := one_sub_sinc u
      push_cast
      linarith)
    (fun u _ hu => by
      have hu0 : u = 0 := by simpa using hu
      show -ysinc u = ((sincC 1 : ℚ) : ℝ)
      rw [e1, hu0]
      simp [ysinc]
      norm_num)
  exact (h.neg.congr fun u _ => by simp).congr_coeff fun i _ => by simp [yC]

/-- Constants of the expansion of `ysinc`: `|ysinc u| ≤ 22 / 125`. -/
def yK (P : ℕ) : ℚ := if P = 0 then 22 / 125 else yK0 P

theorem yK_zero_bound : |yK0 7| * 1 ^ 7 + ∑ i ∈ range 7, |yC i| * 1 ^ i ≤ 22 / 125 := by
  decide +kernel

theorem ysinc_hasExpQ (n : ℕ) (hn : 7 ≤ n) :
    HasExpQ (Set.Icc (0 : ℝ) 1) (fun u => u ^ 2) n ysinc yC yK := by
  have h := (ysinc_hasExpQ0 n).improve_zero gauge_sq_le_one hn
  refine h.mono_const fun P _ => ?_
  rcases P with _ | P
  · exact yK_zero_bound
  · simp [yK]

/-! ### The logarithm -/

theorem log_hasExpQ (n : ℕ) :
    HasExpQ (Set.Icc (0 : ℝ) 1) (fun u => 1 - sinc u) n Lsinc hC (fun _ => 6 / 5) := by
  intro P _ u hu
  obtain ⟨h0, h1⟩ := hu
  have h65 : (((6 / 5 : ℚ)) : ℝ) = 6 / 5 := by norm_num
  show |Lsinc u - ∑ i ∈ range P, (hC i : ℝ) * (1 - sinc u) ^ i| ≤
    (((6 / 5 : ℚ)) : ℝ) * |1 - sinc u| ^ P
  rw [h65]
  have hx0 : 0 ≤ 1 - sinc u := by linarith [sinc_le_one' h0 h1]
  have hx1 : 1 - sinc u ≤ 1 / 6 := by linarith [sinc_ge h0 h1]
  have hL : Lsinc u = -log (1 - (1 - sinc u)) := by
    rw [sub_sub_cancel]
    rfl
  rw [hL]
  generalize 1 - sinc u = x at hx0 hx1 ⊢
  have habs : |x| = x := abs_of_nonneg hx0
  have hax : |x| ≤ 1 / 6 := by rw [habs]; exact hx1
  have hlt : |x| < 1 := by linarith
  rcases P with _ | n
  · have h := abs_log_sub_add_sum_range_le hlt 0
    simp only [range_zero, sum_empty, zero_add, pow_one] at h
    simp only [range_zero, sum_empty, sub_zero, pow_zero, mul_one, abs_neg]
    refine h.trans ?_
    rw [div_le_iff₀ (by linarith)]
    linarith
  · have h := abs_log_sub_add_sum_range_le hlt n
    have hs : ∑ i ∈ range (n + 1), (hC i : ℝ) * x ^ i =
        ∑ i ∈ range n, x ^ (i + 1) / ((i : ℝ) + 1) := by
      rw [sum_range_succ']
      have h0' : (hC 0 : ℝ) = 0 := by simp [hC]
      rw [h0', zero_mul, add_zero]
      refine sum_congr rfl fun i _ => ?_
      have hi : (hC (i + 1) : ℝ) = 1 / ((i : ℝ) + 1) := by simp [hC]
      rw [hi]
      ring
    have e : -log (1 - x) - ∑ i ∈ range n, x ^ (i + 1) / ((i : ℝ) + 1) =
        -((∑ i ∈ range n, x ^ (i + 1) / ((i : ℝ) + 1)) + log (1 - x)) := by ring
    rw [hs, e, abs_neg]
    refine h.trans ?_
    rw [div_le_iff₀ (by linarith)]
    nlinarith [mul_nonneg (pow_nonneg (abs_nonneg x) (n + 1))
      (by linarith : (0 : ℝ) ≤ 1 / 6 - |x|)]

/-- Constants of the expansion of `-log (sin u / u)` in the gauge `u ^ 2`. -/
def LK : ℕ → ℚ := compC hC yC (fun _ => 6 / 5) yK

theorem Lsinc_hasExpQ (n : ℕ) (hn : 7 ≤ n) :
    HasExpQ (Set.Icc (0 : ℝ) 1) (fun u => u ^ 2) n Lsinc logC LK :=
  (log_hasExpQ n).comp (w := fun u => u ^ 2) (y := ysinc) (fun u _ => one_sub_sinc u)
    (ysinc_hasExpQ n hn)

/-! ### The correction `kap` to the Gaussian exponent -/

theorem kap_hasExpQ0 (n : ℕ) (hn : 5 ≤ n) :
    HasExpQ (Set.Icc (0 : ℝ) 1) (fun u => u ^ 2) n kap kapC
      (fun P => |LK (2 + P)| + if P = 0 then |logC 2| else 0) := by
  have h := (Lsinc_hasExpQ (2 + n) (by omega)).shift 2 (g := kap)
    (fun u _ => by
      show Lsinc u = ∑ i ∈ range 2, (logC i : ℝ) * (u ^ 2) ^ i + (u ^ 2) ^ 2 * kap u
      rw [sum_range_succ, sum_range_one, logC_values.1, logC_values.2.1, Lsinc_eq]
      push_cast
      ring)
    (fun u _ hu => by
      have hu0 : u = 0 := by simpa using hu
      show kap u = ((logC 2 : ℚ) : ℝ)
      rw [logC_values.2.2, hu0]
      simp [kap])
  exact h

/-- Upper bound of the constant of order ten of `-log (sin u / u)`. -/
def LK10 : ℚ := 139717 / 2500000000000

theorem LK10_bound : |LK (2 + 8)| + (if (8 : ℕ) = 0 then |logC 2| else 0) ≤ LK10 := by
  decide +kernel

/-- The coefficients `kapC 0, …, kapC 7`. -/
def kapTab : ℕ → ℚ := fun i =>
  ([1 / 180, 1 / 2835, 1 / 37800, 1 / 467775, 691 / 3831077250, 2 / 127702575, 3617 / 2605132530000, 43867 / 350813659321125] : List ℚ).getD i 0

theorem kapC_eq_kapTab : ∀ i ∈ range 8, kapC i = kapTab i := by decide +kernel

/-- Constants of the expansion of `kap`, orders `0, …, 8`. -/
def kapK : ℕ → ℚ := fun P =>
  ([296857 / 50000000, 19079 / 50000000, 288463 / 10000000000, 239121 / 100000000000, 253429 / 1000000000000, 730617 / 10000000000000, 574003 / 10000000000000, 560119 / 10000000000000, 139717 / 2500000000000] : List ℚ).getD P 0

theorem kapK_bound : ∀ P ∈ range 9,
    |LK10| * 1 ^ (8 - P) + ∑ i ∈ range (8 - P), |kapTab (P + i)| * 1 ^ i ≤ kapK P := by
  decide +kernel

theorem kap_hasExpQ :
    HasExpQ (Set.Icc (0 : ℝ) 1) (fun u => u ^ 2) 8 kap kapTab kapK := by
  have h0 := kap_hasExpQ0 8 (by norm_num)
  have htop : ∀ u ∈ Set.Icc (0 : ℝ) 1,
      |kap u - ∑ i ∈ range 8, (kapTab i : ℝ) * (u ^ 2) ^ i| ≤ (LK10 : ℝ) * |u ^ 2| ^ 8 := by
    intro u hu
    have e : ∑ i ∈ range 8, (kapTab i : ℝ) * (u ^ 2) ^ i =
        ∑ i ∈ range 8, (kapC i : ℝ) * (u ^ 2) ^ i :=
      sum_congr rfl fun i hi => by rw [kapC_eq_kapTab i hi]
    rw [e]
    refine (h0 8 le_rfl u hu).trans (mul_le_mul_of_nonneg_right ?_ (by positivity))
    exact_mod_cast LK10_bound
  refine (HasExpQ.of_top gauge_sq_le_one htop).mono_const fun P hP => ?_
  exact kapK_bound P (mem_range.2 (by omega))

theorem kap_abs_le {u : ℝ} (hu : u ∈ Set.Icc (0 : ℝ) 1) : |kap u| ≤ (kapK 0 : ℝ) :=
  kap_hasExpQ.bdd hu

/-! ### The powers of `kap` -/

/-- Constants of the expansions of `kap ^ k`: `kpK k q` bounds the remainder of order `q`. -/
def kpK : ℕ → ℕ → ℚ := fun k q =>
  ((([
    [1, 0, 0, 0, 0, 0, 0, 0],
    [296857 / 50000000, 19079 / 50000000, 288463 / 10000000000, 239121 / 100000000000, 253429 / 1000000000000, 730617 / 10000000000000, 574003 / 10000000000000, 560119 / 10000000000000],
    [352497 / 10000000000, 438539 / 100000000000, 233059 / 500000000000, 477513 / 10000000000000, 533491 / 100000000000000, 56141 / 50000000000000, 708451 / 1000000000000000, 667863 / 1000000000000000],
    [104641 / 500000000000, 189069 / 5000000000000, 128831 / 25000000000000, 126001 / 200000000000000, 771213 / 10000000000000000, 68729 / 5000000000000000, 675121 / 100000000000000000, 23991 / 4000000000000000],
    [62127 / 50000000000000, 57987 / 200000000000000, 120011 / 2500000000000000, 136371 / 20000000000000000, 920881 / 1000000000000000000, 153363 / 1000000000000000000, 592769 / 10000000000000000000, 481999 / 10000000000000000000],
    [46107 / 6250000000000000, 26061 / 12500000000000000, 404803 / 1000000000000000000, 13091 / 200000000000000000, 48629 / 5000000000000000000, 160293 / 100000000000000000000, 63359 / 125000000000000000000, 366693 / 1000000000000000000000],
    [43799 / 1000000000000000000, 17997 / 1250000000000000000, 9991 / 3125000000000000000, 289611 / 500000000000000000000, 941561 / 10000000000000000000000, 79239 / 5000000000000000000000, 43077 / 10000000000000000000000, 135671 / 50000000000000000000000],
    [260041 / 1000000000000000000000, 193399 / 2000000000000000000000, 241037 / 10000000000000000000000, 773 / 160000000000000000000, 853859 / 1000000000000000000000000, 149211 / 1000000000000000000000000, 365671 / 10000000000000000000000000, 24803 / 1250000000000000000000000]] : List (List ℚ)).getD k []).getD q 0)

theorem kpK_bound : ∀ k ∈ range 8, ∀ q ∈ range 8, powC kapTab kapK k q ≤ kpK k q := by
  decide +kernel

/-- Expansion of `kap ^ k` with explicit constants, in the form used by the Laplace method. -/
theorem kap_pow_bound {k q : ℕ} (hk : k < 8) (hq : q < 8) {u : ℝ}
    (hu : u ∈ Set.Icc (0 : ℝ) 1) :
    |kap u ^ k - ∑ i ∈ range q, cpow kapR k i * (u ^ 2) ^ i| ≤ (kpK k q : ℝ) * |u ^ 2| ^ q := by
  have h := (kap_hasExpQ.pow k) q (by omega) u hu
  have e : ∑ i ∈ range q, cpow kapR k i * (u ^ 2) ^ i =
      ∑ i ∈ range q, ((cpow kapTab k i : ℚ) : ℝ) * (u ^ 2) ^ i := by
    refine sum_congr rfl fun i hi => ?_
    have hi' := mem_range.1 hi
    rw [show ((cpow kapTab k i : ℚ) : ℝ) = cpow (fun j => (kapTab j : ℝ)) k i from
      map_cpow (Rat.castHom ℝ) kapTab k i]
    rw [cpow_congr (a := kapR) (b := fun j => (kapTab j : ℝ)) k i fun j hj => by
      show ((kapC j : ℚ) : ℝ) = ((kapTab j : ℚ) : ℝ)
      rw [kapC_eq_kapTab j (mem_range.2 (by omega))]]
  rw [e]
  exact h.trans (mul_le_mul_of_nonneg_right
    (by exact_mod_cast kpK_bound k (mem_range.2 hk) q (mem_range.2 hq)) (by positivity))

end PrivateApex
